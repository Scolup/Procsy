{
  "name": "procsy",
  "version": "1.4.0",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "start:bun": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "dev:node": "tsx watch src/index.ts",
    "test": "bun test",
    "e2e": "node scripts/e2e.mjs",
    "chaos": "node scripts/chaos.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.12.22",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "bun-types": "^1.4.5",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
