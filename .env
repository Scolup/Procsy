DEFAULT_BASE_URL=example.com
FORCE_HTTPS=false
ALLOW_ORIGIN=*
SPOOF_IP=true
ALLOW_BASE_URL_HEADER=true
POPULATE_HEADER=[]

# Trust X-Forwarded-Proto (default true). Needed behind Cloudflare Tunnel, nginx,
# Caddy...: they terminate TLS, so the server itself only ever sees plain http.
# TRUST_PROXY=true
# One log line per request (host, path, status, timing, reason). No queries,
# headers or cookies are ever logged.
# LOG_REQUESTS=true
# Milliseconds to wait for upstream response headers; 0 disables.
# UPSTREAM_TIMEOUT_MS=60000
# Dangerous: lets callers reach private/internal addresses through the proxy.
# ALLOW_PRIVATE_TARGETS=false

# Server options (use HOST=0.0.0.0 to listen on all interfaces)
HOST=127.0.0.1
PORT=3000
